---
// /pageScrollDecoration

// Components
import ArticleCard from "../components/ArticleCard.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
// コンテンツデータ
import { articlesData } from "../data/articles_scrollDeco.ts";
// CSS
import '../styles/pageScrollDecoration.scss';
---

<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<title>pageScrollDecoration | Immersive Scroll Experience Components</title>
</head>

<body>
<main class="psd-page">
  {/* 画面右端のスクロール位置(プログレス)表示 デコレーションUI要素 */}
  <ScrollProgress total={articlesData.length} />

  {/* コンテンツデータを<article>コンポーネントへ展開 */}
  {articlesData.map((data) => (
    <ArticleCard
      index={data.index}
      title={data.title}
      subtitle={data.subtitle}
      description={data.description}
      bgImage={data.bgImage}
    />
  ))}

  {/*
   * <article>内のコンテンツ量とスクロールの連動について * 
    コンテンツ適応型スクロール（Adaptive Section Heights)
    　演出上、articleの高さが固定されてしまうため、掲載内容に合わせた動的な ScrollTrrigerの endポイント指定ができるように拡張する
    コンテンツの高さ(最後（最下部）)までスクロールしきってから次のセクションが被さるように制御を見直し。
   */}


</main>

<script>
// export function initPageScrollDecoration()
import { initPageScrollDecoration } from '../js/pageScrollDecoration';

document.addEventListener('DOMContentLoaded', () => {
  initPageScrollDecoration();
});
</script>
</body>

</html>

<style lang="scss">
body {
  margin: 0;
}
</style>