<script>
/* ==================================================
 SCRIPT
  document.addEventListener('DOMContentLoaded', () => {}
    DOMの構築後にスクリプトを実行します。
  1. ローディング風演出 Circle, Welcome!オーバーレイ
  2. 不定形の有機的パス(SVG)を中央に収縮する演出
  3. GSAP Timeline
====================================================== */
// アニメーションライブラリの読み込み
import { gsap } from 'gsap';

document.addEventListener('DOMContentLoaded', () => {

/*
const container = document.getElementById('firstview-2nd');
const blackBg = document.getElementById('fv-black-bg');
const maskOverlay = document.getElementById('fv-mask-overlay');
const circle = document.getElementById('fv-circle');
const welcomeBox = document.getElementById('fv-welcome-box');
const logoBox = document.getElementById('fv-logo-box');
if (!container || !blackBg || !maskOverlay || !circle || !welcomeBox || !logoBox) return;
*/
// 操作要素の取得
const container = document.getElementById('firstview-2nd');
const blackPath = document.getElementById('fv-black-path') as SVGPathElement | null;
const maskOverlay = document.getElementById('fv-mask-overlay');
const welcomeBox = document.getElementById('fv-welcome-box');
const circle = document.getElementById('fv-circle');
const logoBox = document.getElementById('fv-logo-box');
if (!logoBox) {
  console.warn('FirstView2nd: #fv-logo-box が見つかりませんでした。');
  return;
}
if (!circle) {
  console.warn('FirstView2nd: #fv-circle が見つかりませんでした。');
  return;
}
const logoLetters = logoBox.querySelectorAll('path, g');
//const logoBox = document.querySelectorAll('#fv-logo-box');

if (!container || !blackPath || !maskOverlay || !welcomeBox){
      console.warn('FirstView2nd: 必要なDOM要素が見つかりませんでした。');
      return;
    }// return;

// SVG内の全パス要素を取得
const welcomePaths = welcomeBox.querySelectorAll('path');
const exclamationMark = welcomePaths.length > 0 ? welcomePaths[welcomePaths.length - 1] : null;

// GSAPメインタイムライン
const tl = gsap.timeline({
  onComplete: () => {
    container.classList.add('is-completed');// タイムライン完了でクラス付与
    document.dispatchEvent(new CustomEvent('firstview:complete'));
  }
});


/* =========================================================
 * タイムライン Phase 1: 黒背景フェーズ
 * ローディング風ストローク演出
 * ========================================================= */
// 演出時間定義
const playDuration = Math.random() * 1.0 + 1.0;// 1.0秒~2.0秒未満の間でランダムに生成
// この演出の進捗を管理するオブジェクト
const strokeState = { progress: 0 };

// circle と Welcome! を同期させたタイムラインを定義
tl.to( strokeState, {
  progress: 1,
  duration: playDuration,
  //スタッカート調のイージング
  ease: 'steps(12)',
  onUpdate: () => {
    const p = strokeState.progress;

    // circleの同期描画 (dashoffset: 816.81 → 0)
    const offset = 816.81 * (1-p);
    circle.style.stroke = '#f9edd9';
    circle.setAttribute( 'stroke-dashoffset', offset.toString() );

    // Welcome! オーバーレイ (scaleX: 1 → 0)
    maskOverlay.style.transform = `scaleX(${1 - p})`;

    // フリッカー演出
    if(p < 0.95){ // 95%未満
      const randomOpacity = Math.random() < 0.3 ? Math.random() * 0.4 + 0.5 : 1.0;
      circle.style.opacity = randomOpacity.toString();      
    } else {
      // 演出完了時に通常表示
      circle.style.opacity = '1';
      welcomeBox.style.opacity ='1';
    }

  }
}, 0); // 時間軸 '0' で同時スタート



/* ======================================
 * タイムライン Phase 2: 切り替えフェーズ（布状モーフィング吸い込み） 
 * 収縮する黒背景
 * ====================================== */
// -------- ランダム制御点の生成ロジック --------
// 制御点の総数を生成する
//   点の数8~14ぐらいを想定。
const pointCount = Math.floor( Math.random() * 7 ) + 8; // ランダム値0~6 + 8
// 座標基準値(ランダムな位置の算出時に基準となる値) 定数
const baseRadius = 707;// SVGのサイズ 1000^2の四隅まで覆う初期の半径... 500 * √2
const centerX = 500;
const centerY = 500;

// 制御点オブジェクト...初期状態・ターゲット状態のオブジェクト配列
interface CustomPoint {
  angle: number;
  currentR: number; // 現在の半径 (GSAPで補完する)
  speedRatio: number; // 先行・遅延の速度差 (0.2〜1.0)
}
const points: CustomPoint[] = []; // 配列オブジェクト初期化

// 制御点の数分のランダムなパラメータを生成する
for( let i=0; i < pointCount; i++){
  // 制御点の座標=角度をランダムに散らす ...制御点の個数(インクリメント)/総数 * π の2倍に 微小な調整値(ランダム)を追加(ちょっと小さくなる)
  const angle = ( i/pointCount ) * Math.PI * 2 + (Math.random() * 0.2 -0.1);
  // 先行して縮む点=値が大きい と、遅れて縮む点=値が小さい の生成
  //  ランダム生成値が0.4未満 → ランダム生成値の40% + 0.7 → 先行収縮点 | 遅れて収縮点は +0.2
  const speedRatio = Math.random() < 0.4 ? Math.random() * 0.4 + 0.7 : Math.random() * 0.4 + 0.2;
  // オブジェクト配列に追加
  points.push({
    angle,
    currentR: baseRadius,
    speedRatio
  });
}

// GSAP更新状態を数値で管理するオブジェクト
const animationProgress = { progress: 0 }

// updatePath() 制御点の座標から ベジュ曲線 = d属性 のレンダリングを行うメソッド
// メソッド内でEventListener内のグローバルな要素(points,centerX,centerY,baseRadius,animationProgress)を使用
const pathRendering = () => {
  if( points.length === 0 ) return; // 制御点生成結果が0のときは停止
  // 制御点オブジェクトの 各点の x, y 座標を算出して配列化 [{x,y}]
  const coordinates = points.map(
    pts => {
      // animationProgress.progress と各点の speedRatio に応じて半径を縮小
      // 先行する点は早く0に到達し、遅延点は後半に一気に0へ収束させる
      // 0, もしくは baseRadius x (更新状態progress の 0.N乗) のどちらか大きい方
      const rVal = Math.max( 0, baseRadius * (1 - Math.pow( animationProgress.progress, pts.speedRatio ) ) );
      return {
        x: centerX + Math.cos(pts.angle) * rVal,
        y: centerY + Math.sin(pts.angle) * rVal
      };
    }
  );
  // ポイント間を繋ぐ 二次ベジェ曲線 (Q) でのパス文字列を作成
  let d = `M ${coordinates[0].x} ${coordinates[0].y}`;
  for( let i = 0; i < coordinates.length; i++) {
    // 閉じたパスを作るために 次に来る要素(座標)を インデックスを剰余で取得する Ex.要素数10のとき...末尾インデックス:9 + 1 % 10 = 1...0 → 0番目の要素を取得する
    const next = coordinates[ (i+1) % coordinates.length ];
    // 制御点を2点の中間に設定し、曲線を連続して形成する
    const midX = ( coordinates[i].x + next.x) / 2;
    const midY = ( coordinates[i].y + next.y) / 2;
    // Q :隣り合う点同士の中点 → 角張り抑制
    d += ` Q ${coordinates[i].x} ${coordinates[i].y}, ${midX} ${midY}`;
  }
  d += ' Z'; //末尾にZ
  // SVG要素にd要素を付与する
  blackPath.setAttribute('d', d);
}

// 初期描画
pathRendering();


// タイムラインの構築   Phase 2: 切り替えフェーズ（布状モーフィング吸い込み）
tl
  .to(animationProgress, {
    progress: 1,
    duration: 0.9,
    ease: 'power3.in',
    onUpdate: pathRendering
  })

  // 背景の引き込みと同期して Welcomeテキストを不可視化
  .to(welcomeBox, {
      opacity: 0,
      scale: 0.5,
      duration: 0.4,
      ease: 'power2.in'
    }, '<+=0.2')
  
  // ロゴsvgを表示する
  .to( logoBox, {
    opacity: 1,
    //visibility: visible
  });

// 「!」の跳ねモーション（要素が存在する場合）
if (exclamationMark) {
  tl.to(exclamationMark, {
    y: -16,
    duration: 0.25,
    ease: 'power1.out',
    yoyo: true,
    repeat: 1
  }, 0.75);
}



/* =========================================================
  * Phase 3: 終了フェーズ（上昇・整列）
  * ========================================================= */
tl.to(logoLetters, {
  y: '-35vh', // 上部約15%の余白を残す位置へ移動
  duration: 1.0,
  ease: 'power3.out',
  stagger: {
    each: 0.04,
    from: 'center'
  }
});


}); // document.addEventListener

</script>

