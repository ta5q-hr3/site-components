---
/**
 * FirstView2nd.astro
 * 
 * 3フェーズ構成の演出を持つファーストビューコンポーネント（修正版）
 * 1. 黒背景フェーズ: Welcome!のワイプ出現 + 円形Stroke + !の跳ね
 * 2. 切り替えフェーズ: 布状に歪みながら中央へ吸い込まれる黒背景 + ロゴ表示
 * 3. 終了フェーズ: ロゴが1文字ずつバラバラに上昇・整列
 */

// Viteの?raw指定でSVGテキストとして読み込み
//import logoSvgRaw from '../assets/DesignDemo-Logo1.svg?raw';
//import welcomeSvgRaw from '../assets/fv_element1.svg?raw';

// 画像Assetの読み込み  うまくいかないようなので、一旦SVGを直書きにしています (なぜ..
//import { Image } from 'astro:assets';
//import logoImg from '../assets/DesignDemo-Logo1.svg';
//import welcomeImg from '../assets/fv_element1.svg';

---

<div id="firstview-2nd" class="fv-container">
  {/* 下敷きとなるベース背景 (#f9edd9) */}
  <div class="fv-base-bg"></div>

  {/* 布のように変形して中央に吸い込まれる黒背景 (#040619) */}
  <svg class="fv-black-bg-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
    {/* 初期状態は画面全体を覆うパス (1000x1000) */}
    <path
      id="fv-black-path"
      fill="#040619"
      d="M 0 0 C 500 0, 500 0, 1000 0 C 1000 500, 1000 500, 1000 1000 C 500 1000, 500 1000, 0 1000 C 0 500, 0 500, 0 0 Z"
    />
  </svg>

  <div id="fv-black-bg" class="fv-black-bg">
    
    {/* 中央配置する演出要素領域 */}
    <div class="fv-content-wrapper">
      
      {/* 円形Stroke（12時起点・時計回りアニメ） */}
      <svg class="fv-circle-svg" viewBox="0 0 300 300" aria-hidden="true">
        <defs>
          {/* ざらつき質感のSVGノイズフィルター */}
          <filter id="cyber-grain" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>
        <circle
          id="fv-circle"
          cx="150"
          cy="150"
          r="130"
          fill="none"
          stroke="#040619"
          stroke-width="4"
          stroke-dasharray="816.81"
          stroke-dashoffset="816.81"
          filter="url(#cyber-grain)"
        />
      </svg>

      {/* Welcome! SVG & ワイプ用マスク */}
      <div id="fv-welcome-box" class="fv-welcome-box">
        <!-- <Image src={welcomeImg} alt="Welcome!" class="fv-svg-element" /> -->
        <svg id="welcome-letter" class="fv-svg-element" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 396.56 65.62">
          <g id="_layer_11" data-name="layer 11">
