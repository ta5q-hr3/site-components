  &.is-completed {
    pointer-events: none;
  }
}

.fv-base-bg {
  position: absolute;
  inset: 0;
  background-color: #f9edd9;
  z-index: 1;
}

/**
 * 黒背景
 */
.fv-black-bg {
  position: absolute;
  inset: 0;
  //background-color: #040619;
  background-color: transparent;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  
  /**
   * case 1
   * 布状のモーフィング変形を行うための初期設定
   * clip-path の多角形（4頂点）をアニメーションさせて布のような歪みを演出します
   */
  //clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
  //will-change: clip-path, transform, border-radius;
  
  /**
   * case 2
   * 中央を軸に滑らかに縮小・変形させる設定
   */
  transform-origin: center center;
  border-radius: 0%; /* 初期状態は画面いっぱいの四角形 */
  will-change: transform, border-radius, opacity;
}

/**
 * SVG版 黒背景
 */
.fv-black-bg-svg {
  position: absolute;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 2;
  pointer-events: none;
  /* GPUアクセラレーションを有効化してガタつきを極限まで防止 */
  will-change: transform;
}


.fv-content-wrapper {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: clamp(280px, 80vw, 560px);
  height: clamp(280px, 80vw, 560px);
}

/**
